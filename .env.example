# ─────────────────────────────────────────────
# Jay Mataji Tours & Travels — Environment Config
# ─────────────────────────────────────────────
# Copy this file to .env and fill in your real values.
# NEVER commit .env to version control.

# ── PHP Backend: Database Credentials ─────────
# Set these in your cPanel / hosting control panel
# environment variables, NOT in a .env file on the server.
# PHP does not load .env files automatically.
DB_HOST=localhost
DB_USER=your_database_user
DB_PASSWORD=your_strong_database_password
DB_NAME=jay_mataji

# ── Vite / React Frontend ──────────────────────
# These VITE_ variables are baked into the JS bundle at build time.
# Run `npm run build` after changing them.

# WhatsApp business number (digits only, with country code — no + sign)
VITE_WHATSAPP_NUMBER=919825XXXXXX

# Display phone number shown to visitors
VITE_PHONE_DISPLAY=+91 98251 XXXXX

# Business email address
VITE_COMPANY_EMAIL=jaymatajitours@gmail.com

# Canonical domain for SEO (no trailing slash)
VITE_SITE_URL=https://www.jaymatajitours.com

# Optional: Google Analytics Measurement ID (leave empty to disable)
VITE_GA_ID=

# Optional: PHP API server URL (only needed if backend runs on a different host)
# VITE_API_TARGET=http://127.0.0.1:8000
