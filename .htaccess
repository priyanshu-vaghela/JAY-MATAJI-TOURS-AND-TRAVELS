Options -Indexes
DirectoryIndex index.php

# ─── Deny sensitive files ─────────────────────────────────────────────────────
<FilesMatch "^(?:\.env.*|package(?:-lock)?\.json|jay_mataji\.sql|README\.md|vite\.config\.js|config\.php|bootstrap\.php|composer\.(json|lock)|yarn\.lock)$">
  Require all denied
</FilesMatch>

# Block backup and editor temp files
<FilesMatch "\.(bak|swp|orig|save|git|DS_Store)$">
  Require all denied
</FilesMatch>

# ─── Security Headers ─────────────────────────────────────────────────────────
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), geolocation=(), microphone=(), payment=()"
  Header always set X-XSS-Protection "1; mode=block"
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:; connect-src 'self' https://wa.me; frame-ancestors 'none';"
</IfModule>

# ─── Block source / private directories ──────────────────────────────────────
RewriteEngine On
RewriteRule ^(?:legacy|docs|src|server|\.git|\.vscode|\.reticle|node_modules)(?:/|$) - [R=404,L,NC]

# ─── HTTPS Redirect (enable on production host) ──────────────────────────────
# Uncomment these lines when your host has SSL configured:
# RewriteCond %{HTTPS} off
# RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# ─── Trailing slash canonicalisation ─────────────────────────────────────────
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_URI} ^(.+)/$
RewriteRule ^ %1 [R=301,L]

# ─── Serve real files & directories as-is ────────────────────────────────────
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# ─── Sitemap → PHP handler ───────────────────────────────────────────────────
RewriteRule ^sitemap\.xml$ sitemap.xml.php [L,QSA]

# ─── React SPA fallback (no extension = app route) ───────────────────────────
RewriteCond %{REQUEST_URI} !\.[^/]+$
RewriteRule ^ index.php [L,QSA]

# ─── Asset Caching ───────────────────────────────────────────────────────────
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpeg       "access plus 6 months"
  ExpiresByType image/jpg        "access plus 6 months"
  ExpiresByType image/png        "access plus 6 months"
  ExpiresByType image/webp       "access plus 6 months"
  ExpiresByType image/svg+xml    "access plus 1 month"
  ExpiresByType image/x-icon     "access plus 1 year"
  ExpiresByType text/css         "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType application/json "access plus 0 seconds"
  ExpiresByType text/html        "access plus 0 seconds"
  ExpiresByType text/php         "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
  # Immutable hashed build assets (Vite adds content hash to filenames)
  <FilesMatch "\.(js|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(jpg|jpeg|png|webp|gif|svg|ico|woff2?)$">
    Header set Cache-Control "public, max-age=15552000"
  </FilesMatch>
  # No cache for PHP/HTML
  <FilesMatch "\.(php|html)$">
    Header set Cache-Control "no-store, no-cache, must-revalidate"
    Header set Pragma "no-cache"
  </FilesMatch>
</IfModule>

# ─── Compression ─────────────────────────────────────────────────────────────
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css
  AddOutputFilterByType DEFLATE application/javascript application/json application/xml
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# ─── PHP hardening ───────────────────────────────────────────────────────────
<IfModule mod_php.c>
  php_flag display_errors Off
  php_flag log_errors On
  php_value error_log logs/php_errors.log
  php_value upload_max_filesize 2M
  php_value post_max_size 2M
  php_value max_execution_time 30
</IfModule>
